{
  "expo": {
    "name": "wheela-mobile",
    "slug": "wheela",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo3.png",
    "scheme": "wheelamobile",
    "userInterfaceStyle": "automatic",

    "newArchEnabled": false,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wheela.wheela",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wheela uses your location to find nearby drivers and show ride routes.",
        "NSLocationAlwaysUsageDescription": "Wheela uses background location to track trips in progress.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Wheela requires background location access to support real-time trip tracking.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "NSCameraUsageDescription": "Camera access is required for profile verification.",
        "NSPhotoLibraryUsageDescription": "Photo access is required to upload profile images."
      }
    },

    "android": {
      "package": "com.wheela.wheela",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAbOQwCqiWYfyKe-t1SmzUcfgNVFYaXTFo"
        }
      }
    },

    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-location",

      [
        "expo-notifications",
        {
          "icon": "./assets/logo3.png",
          "color": "#0066FF"
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],

      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 23,
            "enableProguardInReleaseBuilds": false,
            "usesCleartextTraffic": false
          },
          "ios": {
            "deploymentTarget": "15.4",
            "useFrameworks": "static"
          }
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "89ca3ed1-d2fb-429a-9fdb-614202a280e5"
      }
    },

    "owner": "wheela",

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "updates": {
      "url": "https://u.expo.dev/89ca3ed1-d2fb-429a-9fdb-614202a280e5",
      "fallbackToCacheTimeout": 0
    }
  }
}
